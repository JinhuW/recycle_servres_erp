{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/claude-session-hook.sh\"",
            "timeout": 10,
            "statusMessage": "Checking session branch isolation…"
          }
        ]
      }
    ]
  }
}
