# Non-secret environment every fleet worker container gets (rs-fleetd passes it
# as --env-file after configs/secrets.env). The same values each compose worker
# set under `environment:`.
AIMM_ENABLE_VNC=1
AIMM_WEBUI_HOST=127.0.0.1
AIMM_WEBUI_PORT=8467
AIMM_OPENSEARCH_URL=http://host.docker.internal:9200
AIMM_OPENSEARCH_INDEX=fb-tracker
