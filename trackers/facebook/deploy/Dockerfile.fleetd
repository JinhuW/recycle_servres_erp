# The fleet host agent: a small, dependency-free Python service plus the Docker
# CLI it drives this host's daemon with, through the mounted socket.
#
# Build from the rs_fleetd package directory:
#   docker build -f deploy/Dockerfile.fleetd -t rs-fleetd:latest rs_fleetd
# (docker-compose.fleetd.yml sets that context.)

# Only the CLI binary is taken; the daemon is the host's own.
FROM docker:27.3.1-cli AS docker-cli

FROM python:3.12-slim-bookworm

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app

COPY pyproject.toml ./
COPY rs_fleetd ./rs_fleetd

RUN pip install --no-cache-dir .

CMD ["rs-fleetd", "run"]
