FROM python:3.12-slim-bookworm

WORKDIR /app

COPY pyproject.toml ./
COPY rs_coordinator ./rs_coordinator

RUN pip install --no-cache-dir .

ENV RS_COORDINATOR_DB=/data/coordinator.db \
    RS_SCREENSHOT_DIR=/data/screenshots
VOLUME ["/data"]
EXPOSE 8500

CMD ["uvicorn", "rs_coordinator.app:app", "--host", "0.0.0.0", "--port", "8500"]
