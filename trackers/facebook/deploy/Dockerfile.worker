# The fleet worker image: the vendored monitor plus rs_worker, the entrypoint
# that turns three RS_FLEET_* variables into a claim from the ERP's fleet.
# Without them the image behaves exactly as ai-marketplace-monitor/Dockerfile
# did: tini runs supervisord with the bind-mounted config, and the homelab
# compose files keep working against it.
#
# Build from this folder's parent (trackers/facebook), so both trees are in
# the context; Dockerfile.worker.dockerignore keeps everything else out:
#
#   docker build -f deploy/Dockerfile.worker \
#       -t ghcr.io/jinhuw/aimm-recycle:$(cat VERSION) \
#       --build-arg RS_VERSION=$(cat VERSION) \
#       --build-arg RS_MONITOR_COMMIT=$(git -C ai-marketplace-monitor rev-parse --short HEAD) \
#       --build-arg CLOAK_BAKE=1 --secret id=cloak_key,env=CLOAKBROWSER_LICENSE_KEY .
#
# CLOAK_BAKE=1 bakes the CloakBrowser binary into the image with the license
# in the secret (a free or paid key; it is only mounted for that one RUN, never
# kept in a layer, ENV or label), and fails without the secret. The flag, not
# the secret, decides: BuildKit leaves a secret out of the cache key, so a
# stock-only build and a baked one would otherwise reuse each other's layer.
# Without it the image is stock-only: a device that asks for cloak
# parks its worker as browser_failed ("no CloakBrowser binary in this
# image") instead of downloading one at run time. Add
# --build-arg RS_CLOAK_VERSION=<version> to label the image with the build
# the secret fetched; the build fails if it is not that one.

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DISPLAY=:99 \
    SCREEN_GEOMETRY=1920x1080x24 \
    VNC_PORT=5900 \
    AIMM_WEBUI_HOST=0.0.0.0 \
    AIMM_WEBUI_PORT=8467 \
    AIMM_ENABLE_VNC=1 \
    AIMM_NOVNC_DIR=/usr/share/novnc \
    AIMM_VNC_HOST=127.0.0.1 \
    AIMM_VNC_PORT=5900

# Xvfb + x11vnc + xauth: the virtual display and VNC the non-headless browser
# needs; websockify + novnc: the browser-based VNC client; supervisor: the
# old mode's process manager; tini: PID 1; curl: the healthcheck. The fonts
# are what a Windows persona's font probe expects to find, in metric-compatible
# form (Arial, Times, Calibri, Cambria) plus emoji and CJK, so its font list
# is not a bare Debian one.
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        xauth \
        supervisor \
        websockify \
        novnc \
        ca-certificates \
        curl \
        git \
        tini \
        fonts-liberation \
        fonts-noto-color-emoji \
        fonts-noto-cjk \
        fonts-crosextra-carlito \
        fonts-crosextra-caladea \
    && rm -rf /var/lib/apt/lists/*

RUN if [ ! -e /usr/share/novnc/vnc.html ] && [ -e /usr/share/novnc/vnc_lite.html ]; then \
        ln -s /usr/share/novnc/vnc_lite.html /usr/share/novnc/vnc.html; \
    fi

WORKDIR /app

# Build identity: the version the worker claims with and reports in every
# heartbeat. "unknown" is an honest answer for an image built by hand.
ARG RS_VERSION=unknown
ARG RS_MONITOR_COMMIT=unknown
ENV RS_VERSION=$RS_VERSION \
    RS_MONITOR_COMMIT=$RS_MONITOR_COMMIT

COPY ai-marketplace-monitor/pyproject.toml ai-marketplace-monitor/README.md ./
COPY ai-marketplace-monitor/src ./src
COPY deploy/worker-constraints.txt /tmp/worker-constraints.txt

# Installed against frozen versions: the monitor's ">=" ranges let every
# rebuild pick a newer Playwright, and so a different Chromium under the same
# device profile. websockets is the VNC relay's (rs_worker/vnc_relay.py needs
# 15 or later for its `proxy=` and `InvalidStatus`).
RUN pip install -c /tmp/worker-constraints.txt . "websockets>=15" cloakbrowser \
    && playwright install --with-deps chromium

# CloakBrowser's binary, fetched with the license in the build secret and kept
# at a fixed path; the run-time launch then never downloads (the variable is
# set even in a stock-only image, so a cloak device there fails at once). The
# download cache goes in the same layer: it holds the key's hash and the
# license server's answer, not something to ship.
ENV CLOAKBROWSER_BINARY_PATH=/opt/cloakbrowser/chrome
ARG CLOAK_BAKE=0
RUN --mount=type=secret,id=cloak_key,required=false sh -ec '\
    if [ "$CLOAK_BAKE" != 1 ]; then \
        echo "CLOAK_BAKE=$CLOAK_BAKE: stock-only image, no CloakBrowser binary"; exit 0; \
    fi; \
    if [ ! -s /run/secrets/cloak_key ]; then \
        echo "CLOAK_BAKE=1 needs the cloak_key secret" >&2; exit 1; \
    fi; \
    cache=$(mktemp -d); \
    bin=$(CLOAKBROWSER_LICENSE_KEY="$(cat /run/secrets/cloak_key)" CLOAKBROWSER_CACHE_DIR="$cache" \
        CLOAKBROWSER_BINARY_PATH= python -m cloakbrowser install | tail -n 1); \
    dir=$(dirname "$bin"); \
    version=$(basename "$dir" | sed -e "s/^chromium-//" -e "s/-pro\$//"); \
    mv "$dir" /opt/cloakbrowser; \
    echo "$version" > /opt/cloakbrowser/VERSION; \
    rm -rf "$cache" /root/.cloakbrowser; \
    test -x "$CLOAKBROWSER_BINARY_PATH"; \
    echo "baked CloakBrowser $version"'

RUN mkdir -p /etc/supervisor/conf.d /var/log/supervisor /root/.ai-marketplace-monitor
COPY ai-marketplace-monitor/docker/supervisord.conf /etc/supervisor/conf.d/aimm.conf

COPY rs_worker ./rs_worker

# Late, so labelling an image never refetches the binary above.
ARG RS_CLOAK_VERSION=
RUN if [ -n "$RS_CLOAK_VERSION" ]; then \
        test "$(cat /opt/cloakbrowser/VERSION 2>/dev/null)" = "$RS_CLOAK_VERSION" \
        || { echo "RS_CLOAK_VERSION=$RS_CLOAK_VERSION but the baked build is $(cat /opt/cloakbrowser/VERSION 2>/dev/null || echo none)" >&2; exit 1; }; \
    fi
LABEL com.recycleservers.cloak-version=$RS_CLOAK_VERSION

# 5900 VNC, 8467 the monitor's web UI, 8788 /healthz in fleet mode.
EXPOSE 5900 8467 8788

# No VOLUME for /root/.ai-marketplace-monitor: in fleet mode the claimed
# session is written there and must die with the container, not linger in an
# anonymous volume. The compose files mount their own named volumes.

# In fleet mode the entrypoint serves /healthz once the monitor is up; the
# old mode has nothing on 8788 and is left as healthy as before (the compose
# files bring their own healthcheck).
HEALTHCHECK --interval=1m --timeout=10s --start-period=5m --retries=3 \
    CMD sh -c 'if [ -n "$RS_FLEET_URL" ]; then curl -sf http://127.0.0.1:8788/healthz; else exit 0; fi'

ENTRYPOINT ["/usr/bin/tini", "--", "python", "-m", "rs_worker.entry"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf", "-n"]
