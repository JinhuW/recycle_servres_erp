<mxfile host="app.diagrams.net"><diagram name="facebook_tracker" id="fbt"><mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="facebook_tracker — system architecture" tooltip="" id="title"><mxCell style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="900" height="34" as="geometry"/></mxCell></UserObject><UserObject label="Facebook Marketplace &amp;amp; Messenger" tooltip="The outside world everything browses. No passwords are stored: every browser (worker, poster, messenger) reuses a captured session pinned to its own user agent and proxy." id="fb"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="66" width="800" height="64" as="geometry"/></mxCell></UserObject><UserObject label="OpenRouter LLM API" tooltip="Rates each candidate listing (JSON verdict: rating, unit_count, summary). Fails closed: if AI is down, listings are withheld and re-scanned. The coordinator's ai.py uses the same backend." id="openrouter"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="66" width="260" height="64" as="geometry"/></mxCell></UserObject><UserObject label="Configuration &amp;amp; sessions" tooltip="" id="L_cfg"><mxCell style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="280" height="410" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;master.toml&lt;/b&gt;&lt;br&gt;regions · cities ·&lt;br&gt;phrases · AI prompt" tooltip="configs/master.toml — WHAT the fleet searches: [region.*] city lists, [item.*] search phrases (server RAM, CPU, enterprise SSD), AI settings." id="master"><mxCell style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_cfg"><mxGeometry x="15" y="42" width="120" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;fleet.toml&lt;/b&gt;&lt;br&gt;which worker&lt;br&gt;gets which region" tooltip="configs/fleet.toml — WHO searches where. A worker's scope only changes when this file is edited and configs regenerated." id="fleet"><mxCell style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_cfg"><mxGeometry x="145" y="42" width="120" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;rsc gen-configs&lt;/b&gt; (sharding)" tooltip="rs_coordinator/sharding.py + cli.py. Combines master.toml and fleet.toml into one config shard per worker." id="gen"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_cfg"><mxGeometry x="40" y="132" width="200" height="38" as="geometry"/></mxCell></UserObject><UserObject label="configs/generated/&lt;br&gt;&lt;b&gt;worker-&amp;lt;id&amp;gt;.toml&lt;/b&gt;" tooltip="One generated config per worker VM. Shipped to the VM by scripts/deploy.sh." id="shards"><mxCell style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_cfg"><mxGeometry x="40" y="192" width="200" height="50" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;rs-session&lt;/b&gt; capture · import · check&lt;br&gt;fills 2FA from stored TOTP secret" tooltip="rs_poster/session_cli.py. Log in once by hand (through the worker's own proxy); only the cookies are kept. Sessions last weeks." id="rssession"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_cfg"><mxGeometry x="15" y="272" width="250" height="46" as="geometry"/></mxCell></UserObject><UserObject label="configs/sessions/&lt;b&gt;&amp;lt;id&amp;gt;.json&lt;/b&gt;&lt;br&gt;cookies + UA/proxy sidecar" tooltip="Playwright storage-state plus a .meta.json sidecar that pins user agent and proxy. Used by monitor, poster and messenger." id="sessions"><mxCell style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_cfg"><mxGeometry x="40" y="340" width="200" height="50" as="geometry"/></mxCell></UserObject><UserObject label="Monitor fleet · 6 worker VMs (aimm-recycle)" tooltip="" id="L_mon"><mxCell style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="380" height="410" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;ne-1&lt;/b&gt;&lt;br&gt;Northeast" tooltip="Worker ne-1 (Northeast). Cities: Boston, NYC, Philly, Pittsburgh. Statically pinned: one region, one Facebook account, one proxy." id="w_ne-1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="15" y="40" width="110" height="38" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;se-1&lt;/b&gt;&lt;br&gt;Southeast" tooltip="Worker se-1 (Southeast). Cities: DC, Charlotte, Atlanta, Miami. Statically pinned: one region, one Facebook account, one proxy." id="w_se-1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="135" y="40" width="110" height="38" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;mw-1&lt;/b&gt;&lt;br&gt;Midwest" tooltip="Worker mw-1 (Midwest). Cities: Detroit, Chicago, Minneapolis, St. Louis. Statically pinned: one region, one Facebook account, one proxy." id="w_mw-1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="255" y="40" width="110" height="38" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;sc-1&lt;/b&gt;&lt;br&gt;South Central" tooltip="Worker sc-1 (South Central). Cities: Memphis, Dallas, Houston, New Orleans. Statically pinned: one region, one Facebook account, one proxy." id="w_sc-1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="15" y="86" width="110" height="38" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;denver-1&lt;/b&gt;&lt;br&gt;Mountain" tooltip="Worker denver-1 (Mountain). Cities: Denver, Billings, SLC, Albuquerque. Statically pinned: one region, one Facebook account, one proxy." id="w_denver-1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="135" y="86" width="110" height="38" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;wc-1&lt;/b&gt;&lt;br&gt;West Coast" tooltip="Worker wc-1 (West Coast). Cities: Seattle, Portland, Sacramento, LA, Phoenix. Statically pinned: one region, one Facebook account, one proxy." id="w_wc-1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="255" y="86" width="110" height="38" as="geometry"/></mxCell></UserObject><UserObject label="inside every worker" tooltip="" id="g_pipe"><mxCell style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=2;arcSize=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="12" y="142" width="356" height="196" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Search&lt;/b&gt;&lt;br&gt;city URL ·&lt;br&gt;Playwright" tooltip="ai-marketplace-monitor (upstream, AGPL) on our recycle-patches branch: facebook.py builds the search URL anchored to the city slug. Coverage comes from the number of cities, not the radius." id="search"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="22" y="170" width="104" height="56" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Keyword&lt;/b&gt;&lt;br&gt;filter" tooltip="Cheap include/exclude keyword pass before spending an LLM call." id="kw"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="138" y="170" width="104" height="56" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;AI rating&lt;/b&gt;&lt;br&gt;keep if ≥ 4" tooltip="ai.py: one structured call per listing. Single-unit listings are suppressed in code whatever their score." id="rate"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="254" y="170" width="104" height="56" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;coordinator_notify&lt;/b&gt;&lt;br&gt;listings · heartbeat ·&lt;br&gt;auth codes · escalations" tooltip="coordinator_notify.py / control_plane.py. Workers never message Telegram directly — everything goes to the coordinator." id="report"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="22" y="260" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;x11vnc&lt;/b&gt; :5900&lt;br&gt;live browser" tooltip="Each monitor container runs a virtual display (xvfb) plus x11vnc, so a human can watch or take over the logged-in browser." id="vnc"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_mon"><mxGeometry x="270" y="260" width="88" height="64" as="geometry"/></mxCell></UserObject><UserObject label="Posting &amp;amp; Messenger bridge" tooltip="" id="L_msg"><mxCell style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="180" width="380" height="410" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;rs-poster&lt;/b&gt;&lt;br&gt;publishes&lt;br&gt;“we buy servers”&lt;br&gt;ads, reposts on&lt;br&gt;a schedule" tooltip="rs_poster/poster.py (Playwright). Reimplements the old Selenium facebook-marketplace-bot flow. Keeps ads near the top of the feed. Does not talk to the coordinator." id="poster"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_msg"><mxGeometry x="15" y="42" width="110" height="100" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;ads/&lt;/b&gt;&lt;br&gt;photo library" tooltip="rs_poster/ads + photo_library.py: ad copy and photos." id="photos"><mxCell style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_msg"><mxGeometry x="15" y="164" width="110" height="54" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;rs-messenger&lt;/b&gt;&lt;br&gt;inbox scraper&lt;br&gt;(Playwright)&lt;br&gt;fallback sender" tooltip="rs_messenger: polls each account's Marketplace inbox every 300 s, reports threads via /v1/messages/sync, sends queued 'playwright' replies." id="messenger"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_msg"><mxGeometry x="137" y="42" width="110" height="100" as="geometry"/></mxCell></UserObject><UserObject label="Matrix stack" tooltip="" id="g_matrix"><mxCell style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=2;arcSize=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_msg"><mxGeometry x="257" y="26" width="113" height="290" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;mautrix-meta&lt;/b&gt;&lt;br&gt;real Messenger&lt;br&gt;bridge" tooltip="mautrix-meta puts each buyer conversation in its own Matrix room. Primary transport for replies." id="mautrix"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_msg"><mxGeometry x="265" y="52" width="97" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Conduit&lt;/b&gt;&lt;br&gt;homeserver" tooltip="Lightweight Matrix homeserver (docker-compose.matrix.yml, homelab VM)." id="conduit"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_msg"><mxGeometry x="265" y="142" width="97" height="54" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;rs-router&lt;/b&gt;&lt;br&gt;Matrix ⇄&lt;br&gt;coordinator" tooltip="Stdlib-only Python loop (every 2 s): reports room messages to the coordinator and delivers queued 'matrix' replies." id="router"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_msg"><mxGeometry x="265" y="224" width="97" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Replies split by &lt;b&gt;transport&lt;/b&gt;: &lt;i&gt;matrix&lt;/i&gt; → rs-router,&lt;br&gt;&lt;i&gt;playwright&lt;/i&gt; → rs-messenger (never sent twice).&lt;br&gt;Auto-reply: off unless armed; ≤1/thread, ≤20/day." tooltip="" id="transport"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=8;fillColor=#fffde7;strokeColor=#b0a060;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="610" width="260" height="76" as="geometry"/></mxCell></UserObject><UserObject label="Dashboard access" tooltip="" id="L_con"><mxCell style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="280" height="380" as="geometry"/></mxCell></UserObject><UserObject label="ERP console&lt;br&gt;user" tooltip="Staff using the ERP dashboard: fleet view, challenges, VNC." id="erp"><mxCell style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_con"><mxGeometry x="105" y="40" width="70" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;cloudflared&lt;/b&gt; tunnel" tooltip="Cloudflare tunnel: the only public entry point. Nothing in the fleet listens on the internet." id="cf"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_con"><mxGeometry x="30" y="150" width="220" height="42" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;rs-console&lt;/b&gt; :8600&lt;br&gt;read-mostly facade&lt;br&gt;&lt;br&gt;fleet view · stats ·&lt;br&gt;challenge resolve ·&lt;br&gt;relogin · VNC ticket" tooltip="rs_console/app.py. Exists because the coordinator holds every account's secrets and must stay loopback-only; the console exposes only safe, mostly read-only routes." id="console"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_con"><mxGeometry x="30" y="230" width="220" height="120" as="geometry"/></mxCell></UserObject><UserObject label="rs_coordinator · FastAPI :8500 · loopback-only · holds all secrets" tooltip="" id="L_coord"><mxCell style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=4;swimlaneFillColor=#ffffff;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="800" height="380" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;listings · heartbeat&lt;/b&gt;&lt;br&gt;/api/v1/listings&lt;br&gt;/api/v1/heartbeat" tooltip="routers/listings.py + health.py. Workers report matches and liveness here." id="api_l"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="15" y="44" width="175" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;auth · escalation&lt;/b&gt;&lt;br&gt;2FA codes · credentials&lt;br&gt;CAPTCHA hand-off" tooltip="routers/auth.py + escalation.py. When a worker hits a CAPTCHA or checkpoint it stops and hands it to a human (shown in the console)." id="api_a"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="205" y="44" width="175" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;messages · threads&lt;/b&gt;&lt;br&gt;sync · outbound · ack&lt;br&gt;claim · reply" tooltip="routers/messages.py. One thread row per buyer conversation, linked to a Matrix room and a Telegram forum topic." id="api_m"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="395" y="44" width="175" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;session · stats · accounts&lt;/b&gt;&lt;br&gt;session backup/restore&lt;br&gt;review stats" tooltip="routers/session.py, stats.py, accounts.py." id="api_s"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="585" y="44" width="200" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;dedupe&lt;/b&gt;&lt;br&gt;by Facebook item id" tooltip="dedupe.py: adjacent regions both see border listings; the item id makes it exactly one alert." id="dedupe"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="15" y="144" width="175" height="54" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;vault&lt;/b&gt; (Fernet) +&lt;br&gt;TOTP / email codes" tooltip="vault.py, code_service.py, totp_code.py, email_codes.py: encrypted passwords/TOTP secrets; codes generated or scraped from the account's inbox." id="vault"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="205" y="144" width="175" height="54" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;auto-reply policy&lt;/b&gt;&lt;br&gt;default off" tooltip="autoreply.py: pure decision logic, at most one automated reply per thread, capped per rolling day." id="autoreply"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="395" y="144" width="175" height="54" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;ai.py&lt;/b&gt;&lt;br&gt;coordinator AI helpers" tooltip="Same OpenRouter backend as the monitor." id="ai"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="585" y="144" width="200" height="54" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;SQLite / PostgreSQL&lt;/b&gt;&lt;br&gt;listings · sightings · threads · outbox · accounts" tooltip="db.py (SQLite) or pg.py (drop-in Postgres). 'sightings' records every worker report so overlap stays auditable." id="db"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="15" y="232" width="365" height="90" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;background loop&lt;/b&gt;&lt;br&gt;deliver outbox ·&lt;br&gt;sweep fleet liveness" tooltip="background.py: one daemon thread, idempotent, driven by the database, so a restart resumes where it left off." id="bg"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="L_coord"><mxGeometry x="395" y="232" width="175" height="90" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;telegram_notify&lt;/b&gt; (send)&lt;br&gt;&lt;b&gt;telegram_consumer&lt;/b&gt;&lt;br&gt;(read sta