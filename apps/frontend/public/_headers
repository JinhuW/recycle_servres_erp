# Cloudflare parses this file and applies the rules to static-asset responses;
# it is never served itself. Without it every asset gets the Workers Static
# Assets default of `public, max-age=0, must-revalidate` — including the
# content-hashed ones — so a repeat visit revalidates the whole bundle.

# Content-hashed by the build: the filename changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# NOT content-hashed. A day is the cost of shipping a new icon, and the
# manifest/apple-touch slots are re-read rarely enough that it doesn't matter.
/icons/*
  Cache-Control: public, max-age=86400

# These three are how a deploy reaches an already-installed client. Cache any
# of them and the update can never arrive.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
