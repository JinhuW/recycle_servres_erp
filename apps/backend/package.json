{
  "name": "recycle-erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:seed": "node ./scripts/seed.mjs",
    "db:reset": "node ./scripts/migrate.mjs --reset && node ./scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/node-server": "^1.19.17",
    "@recycle-erp/shared": "workspace:*",
    "@tsndr/cloudflare-worker-jwt": "^3.1.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.2.1",
    "jose": "^6.2.3",
    "mailparser": "^3.9.33",
    "nodemailer": "^10.0.13",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
